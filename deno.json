{
  "name": "@hiisi/tgts",
  "version": "0.2.0-alpha.1",
  "description": "Target definitions and schemas for multi-target TypeScript compilation: runtimes, platforms, architectures, and capabilities.",
  "license": "MPL-2.0",
  "exports": {
    ".": "./mod.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "@hiisi/viola": "jsr:@hiisi/viola@^0.3.1",
    "@hiisi/viola-default-lints": "jsr:@hiisi/viola-default-lints@^0.3.1",
    "@hiisi/flash-freeze": "jsr:@hiisi/flash-freeze@^0.1.1",
    "@hiisi/viola-grammar-ts": "jsr:@hiisi/viola-grammar-ts@^0.3.1"
  },
  "lint": {
    "include": [
      "**/*.ts"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-await-in-loop",
        "no-console",
        "no-const-assign",
        "no-eval",
        "no-implicit-declare-namespace-export",
        "no-non-null-asserted-optional-chain",
        "no-self-compare",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "prefer-ascii",
        "single-var-declarator",
        "verbatim-module-syntax"
      ],
      "exclude": [
        "no-console"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "include": [
      "**/*.ts",
      "*.md"
    ]
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net",
    "test:watch": "deno test --allow-read --allow-write --allow-env --allow-run --allow-net --watch",
    "lint": "deno run -A --min-dep-age=0 jsr:@hiisi/viola-cli@0.3.0-alpha.2 --project . --include src,mod.ts",
    "lint:fix": "deno lint --fix",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check mod.ts",
    "all": "deno task fmt && deno task lint && deno task check && deno task test",
    "prepublish": "deno task all"
  },
  "publish": {
    "include": [
      "mod.ts",
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "tests/",
      "scripts/",
      ".githooks/",
      "viola.config.ts"
    ]
  },
  "repository": "https://github.com/hiisi-digital/tgts",
  "distDir": "target",
  "dist": {
    "node": {
      "runtime": "node",
      "versions": [
        "20",
        "22",
        "24"
      ],
      "plugins": [
        "deno-to-node"
      ]
    },
    "bun": {
      "runtime": "bun",
      "versions": [
        "latest"
      ],
      "plugins": [
        "deno-to-bun"
      ]
    }
  },
  "minimumDependencyAge": "0"
}
